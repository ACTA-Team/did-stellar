{
  "name": "@acta-team/did-stellar-indexer",
  "version": "0.1.0",
  "private": true,
  "description": "Reverse index for did:stellar — ingests did-stellar-registry contract events (mainnet + testnet) and answers \"which DIDs does this controller hold?\".",
  "license": "Apache-2.0",
  "author": "ACTA",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "did-stellar-indexer": "dist/bin/worker.js"
  },
  "files": [
    "dist",
    "sql",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "dev": "tsx watch src/bin/worker.ts",
    "start": "node dist/bin/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "measure:controllers": "tsx scripts/measure-controller-dids.ts",
    "clean": "rimraf dist .turbo coverage"
  },
  "engines": {
    "node": ">=22.22.1 <25"
  },
  "dependencies": {
    "@acta-team/did-stellar": "workspace:*",
    "@stellar/stellar-sdk": "^15.0.0",
    "pg": "^8.13.0",
    "pino": "^9.5.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "@vitest/coverage-v8": "^4.1.10",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^7.1.12",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ACTA-Team/did-stellar.git",
    "directory": "packages/indexer"
  }
}
