# did-stellar-api — environment configuration.
#
# Every variable is optional in development; production deployments
# SHOULD pin NETWORK_TYPE, STELLAR_RPC_URL and DID_REGISTRY_CONTRACT_ID.

# Listen port.
PORT=8080

# Network the resolver operates on. Closed set: mainnet | testnet.
NETWORK_TYPE=testnet

# Override the canonical did-stellar-registry contract ID.
# Required in mainnet until the Bloque E deployment lands.
# Testnet default: CB7ATU7SF5QUKJMSULJDJVWJZVDXC23HTZX6NFUDTSFPVT6MA575NNZJ
# DID_REGISTRY_CONTRACT_ID=

# Override the Stellar RPC URL. Defaults to the SDF public endpoint per network.
# Can point to a private pool / balancer.
# STELLAR_RPC_URL=

# Optional Redis URL. When set:
#   - DID resolutions are cached for RESOLVER_CACHE_TTL_SECONDS.
#   - Rate limiting uses a sliding-window counter in Redis (shared
#     across replicas).
# When unset both caches degrade to per-process in-memory.
# REDIS_URL=redis://127.0.0.1:6379

# TTL for the resolver cache, in seconds. Default 30.
RESOLVER_CACHE_TTL_SECONDS=30

# Per-IP rate limit. Defaults to 120 requests / minute.
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_SECONDS=60

# CORS allow-list. Comma-separated origins. `*` is permitted (default for
# a resolver — verifier scripts come from anywhere).
CORS_ORIGINS=*

# Log level (pino): trace | debug | info | warn | error | fatal.
LOG_LEVEL=info

# --- Analytics (PostHog) — OPTIONAL, opt-in --------------------------------
# When POSTHOG_API_KEY is unset the service emits no events and allocates no
# analytics client. Set it to the project's write-only token (phc_...) to
# capture did_resolved / did_mutation / did_mutation_failed events. DIDs are
# never sent raw — the distinctId is a SHA-256 hash and properties carry only
# counts and enums.
# POSTHOG_API_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# POSTHOG_HOST=https://us.i.posthog.com

# --- Reverse index (controller → DIDs) - OPTIONAL, on by default ------------
# Powers GET /v1/dids/stellar?controller=G...&network=testnet, the lookup a
# wallet needs to find the DIDs it already has instead of minting another one.
# Rebuilt from the registry's event stream; see packages/indexer/README.md.
#
# Defaults work with no configuration at all: an in-memory index, both
# networks, rebuilt on every boot. Set DID_INDEX_DATABASE_URL to make it
# durable and shareable across replicas.

# Master switch. false → the endpoint answers 501; resolver endpoints unaffected.
DID_INDEX_ENABLED=true

# embedded → this process also ingests events (right for a single instance).
# external → a separate did-stellar-indexer worker writes; the API only reads.
#            Required as soon as there is more than one replica.
DID_INDEX_MODE=embedded

# Postgres / Supabase connection string. Unset → in-memory (rebuilt on boot).
# Falls back to DATABASE_URL when this is unset.
# DID_INDEX_DATABASE_URL=postgres://user:pass@host:5432/db
# DID_INDEX_PG_SCHEMA=public
# DID_INDEX_PG_SKIP_SCHEMA=false   # true when the schema is under migration control
# DID_INDEX_PG_SSL=true            # auto-enabled for *.supabase.* hosts

# Seconds between event polls. ~2 ledger closes.
DID_INDEX_POLL_SECONDS=10

# Background reconciliation against the ledger: repairs missed events and
# fills in DIDs registered before the RPC's event retention window.
# 0 disables the sweep.
DID_INDEX_RECONCILE_SECONDS=900
DID_INDEX_RECONCILE_BATCH=500

# Confirm every listing against the ledger before answering (one batched
# getLedgerEntries per request). Makes the response authoritative rather
# than eventually-consistent. Turn off for a read-heavy deployment that can
# tolerate a few seconds of ingestion lag.
DID_INDEX_VERIFY_ON_READ=true

# Ingestion RPC per network. Falls back to STELLAR_RPC_URL_{TESTNET,MAINNET}.
# Point at an archival endpoint if you need a backfill deeper than the
# public RPC's retention window (~1 week).
# DID_INDEX_RPC_URL_TESTNET=
# DID_INDEX_RPC_URL_MAINNET=

# First ledger to backfill from, clamped to the RPC's oldestLedger.
# Omit to ingest everything the endpoint still retains.
# DID_INDEX_START_LEDGER_TESTNET=
# DID_INDEX_START_LEDGER_MAINNET=
